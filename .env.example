# 设置到启动 Python 的进程环境中；应用不会自动加载 .env 文件。
# PowerShell: $env:ZHIPU_API_KEY = "你的密钥"
ZHIPU_API_KEY=

# 可选，本地服务端口，默认 5000。
PORT=5000

# 临时公网演示：HTTP Basic Auth，格式 user:password。留空则不启用。
POWANG_BASIC_AUTH=
# 公网只读：1 时禁止写入、删除和触发分析；问答仍可用。
POWANG_READ_ONLY=1
# 演示问答每小时全局上限；0 表示不限制。只读模式默认 30。
POWANG_CHAT_LIMIT=30
